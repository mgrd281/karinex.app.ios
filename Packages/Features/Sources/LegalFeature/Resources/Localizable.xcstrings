    "legal.empty.message" : {
      "comment" : "Shown when a legal text cannot be found in the store.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text ist im Moment nicht verfügbar. Bitte versuchen Sie es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This text is not available right now. Please try again later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
