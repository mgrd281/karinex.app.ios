          }
        }
      }
    },
    "home.support.hours.value" : {
      "comment" : "Service hours in the support card: Monday to Sunday, 06:00 to 23:00 German time (Europe/Berlin). Always say that the hours are German time, so customers in other time zones are not misled. Never use a dash for the range.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mo. bis So., 06:00 bis 23:00 Uhr deutscher Zeit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon to Sun, 06:00 to 23:00 German time"
          }
        }
      }
    },
    "home.support.message" : {
      "comment" : "Text at the top of the support card on the Start tab, above the list of channels (WhatsApp, e-mail, live chat). There is no phone support; never mention a phone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zu Ihrer Bestellung, zur Lieferung oder zur Aktivierung erreichen Sie uns über diese Kanäle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For questions about your order, delivery or activation, you can reach us through these channels."
          }
        }
      }
    },
    "home.support.title" : {
      "comment" : "Serif section title of the support card on the Start tab.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So erreichen Sie uns"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to reach us"
          }
        }
      }
    },
