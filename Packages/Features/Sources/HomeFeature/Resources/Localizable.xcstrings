    "home.support.hours.value" : {
      "comment" : "Service hours in the support card: Monday to Sunday, 06:00 to 23:00 German time (Europe/Berlin). Always say that the hours are German time, because customers in other time zones read it. Keep the 24-hour times \"06:00\" and \"23:00\" exactly; use the customary weekday abbreviations and the word for \"to\" in ranges, never a dash. Max ~50 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man. til søn., 06:00 til 23:00 tysk tid"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mo. bis So., 06:00 bis 23:00 Uhr deutscher Zeit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon to Sun, 06:00 to 23:00 German time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lun. a dom., de 06:00 a 23:00, hora alemana"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivittäin klo 06:00 ja 23:00 välillä Saksan aikaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lun. au dim., de 06:00 à 23:00, heure allemande"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da lun. a dom., dalle 06:00 alle 23:00, ora tedesca"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma t/m zo, 06:00 tot 23:00 uur Duitse tijd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od pon. do niedz., od 06:00 do 23:00 czasu niemieckiego"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seg. a dom., das 06:00 às 23:00, hora da Alemanha"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mån till sön, 06:00 till 23:00 tysk tid"
          }
        }
      }
    },
    "home.support.message" : {
      "comment" : "Text at the top of the support card on the Start tab, above the three channels (WhatsApp, e-mail, live chat): customers can contact KARINEX about their order, delivery or activation. There is no phone support; never mention one. One sentence, max ~110 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du spørgsmål om din ordre, levering eller aktivering, kan du kontakte os via følgende kanaler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zu Ihrer Bestellung, zur Lieferung oder zur Aktivierung erreichen Sie uns über diese Kanäle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a question about your order, delivery or activation, you can reach us through these channels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes dudas sobre tu pedido, la entrega o la activación, escríbenos por estos canales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaustasi, toimitusta tai aktivointia koskevissa kysymyksissä tavoitat meidät näiden kanavien kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour toute question sur votre commande, la livraison ou l’activation, contactez-nous via ces canaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per domande sul tuo ordine, sulla consegna o sull’attivazione, contattaci tramite questi canali."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor vragen over je bestelling, de levering of de activering bereik je ons via deze kanalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W razie pytań o zamówienie, dostawę lub aktywację zapraszamy do kontaktu przez poniższe kanały."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para questões sobre a sua encomenda, a entrega ou a ativação, contacte-nos através destes canais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid frågor om din beställning, leverans eller aktivering når du oss via följande kanaler."
          }
        }
      }
    },
    "home.support.title" : {
      "comment" : "Serif section title of the support card on the Start tab. Short, max ~30 characters.",
      "extractionState" : "manual",
