{
  "sourceLanguage" : "de",
  "strings" : {
    "home.hero.body" : {
      "comment" : "Introduction below the display headline in the hero panel at the top of the Start tab: the range (Windows, Office, other Microsoft software), the only three payment methods and delivery of the key by e-mail. Two sentences, max ~170 characters. Windows, Office, Microsoft, Apple Pay and Klarna are names and stay unchanged; translate \"Kreditkarte\" with the glossary (EN credit card).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licensnøgler til Windows, Office og anden Microsoft-software. Betal med Apple Pay, kreditkort eller Klarna, og modtag din nøgle via e-mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizenzschlüssel für Windows, Office und weitere Microsoft-Software. Bezahlen Sie mit Apple Pay, Kreditkarte oder Klarna und erhalten Sie Ihren Schlüssel per E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence keys for Windows, Office and other Microsoft software. Pay with Apple Pay, credit card or Klarna and receive your key by e-mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claves de licencia para Windows, Office y otro software de Microsoft. Paga con Apple Pay, tarjeta de crédito o Klarna y recibe tu clave por correo electrónico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisenssiavaimet Windowsiin, Officeen ja muihin Microsoft-ohjelmistoihin. Maksa Apple Paylla, luottokortilla tai Klarnalla ja saat avaimesi sähköpostitse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clés de licence pour Windows, Office et d’autres logiciels Microsoft. Payez par Apple Pay, carte bancaire ou Klarna et recevez votre clé par e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codici di licenza per Windows, Office e altri software Microsoft. Paga con Apple Pay, carta di credito o Klarna e ricevi il tuo codice via e-mail."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licentiesleutels voor Windows, Office en andere Microsoft-software. Betaal met Apple Pay, creditcard of Klarna en ontvang je sleutel per e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze licencyjne do Windows, Office i innego oprogramowania Microsoft. Zapłać przez Apple Pay, kartą kredytową lub przez Klarna, a klucz otrzymasz e-mailem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaves de licença para Windows, Office e outro software Microsoft. Pague com Apple Pay, cartão de crédito ou Klarna e receba a sua chave por e-mail."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licensnycklar för Windows, Office och annan Microsoft-programvara. Betala med Apple Pay, kreditkort eller Klarna och få din nyckel via e-post."
          }
        }
      }
    },
    "home.hero.cta" : {
      "comment" : "Primary full-width button in the hero panel of the Start tab; opens the Shop tab with the product range. Short verb phrase, one line, max ~25 characters. Same text as \"cart.empty.action\" in the basket; translate both identically. Glossary: Sortiment (EN range).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
