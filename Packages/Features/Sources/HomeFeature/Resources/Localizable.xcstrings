    "home.trust.footnote" : {
      "comment" : "Footnote below the four trust fact tiles on the Start tab; the app puts the marker * in front of it (not part of this text). The money-back conditions in short form: only activated licence keys and physical goods; delivered but unactivated keys are not refunded voluntarily; statutory warranty rights are not affected. Keep all three parts and their legal meaning. Three short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder kun for aktiverede licensnøgler og fysiske varer. Leverede, men ikke aktiverede nøgler refunderes ikke frivilligt. Den lovbestemte reklamationsret påvirkes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für aktivierte Lizenzschlüssel und physische Ware. Gelieferte, nicht aktivierte Schlüssel werden nicht freiwillig erstattet. Gesetzliche Gewährleistungsrechte bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies only to activated licence keys and physical goods. Keys that have been delivered but not activated are not refunded voluntarily. Statutory warranty rights are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aplica a claves de licencia activadas y a productos físicos. Las claves entregadas pero no activadas no se reembolsan de forma voluntaria. Los derechos de garantía legal no se ven afectados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee vain aktivoituja lisenssiavaimia ja fyysisiä tuotteita. Toimitettuja mutta aktivoimattomia avaimia ei hyvitetä vapaaehtoisesti. Lakisääteiset oikeudet virhetilanteissa säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valable uniquement pour les clés de licence activées et les produits physiques. Les clés livrées mais non activées ne font pas l’objet d’un remboursement volontaire. Les droits au titre de la garantie légale ne sont pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale solo per i codici di licenza attivati e per i prodotti fisici. I codici consegnati ma non attivati non vengono rimborsati su base volontaria. Restano salvi i diritti di garanzia legale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt alleen voor geactiveerde licentiesleutels en fysieke producten. Geleverde, niet geactiveerde sleutels komen niet in aanmerking voor vrijwillige terugbetaling. Wettelijke garantierechten blijven onverminderd van kracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy wyłącznie aktywowanych kluczy licencyjnych i towarów fizycznych. Dostarczone, ale nieaktywowane klucze nie podlegają dobrowolnemu zwrotowi pieniędzy. Ustawowe uprawnienia z tytułu niezgodności z umową pozostają nienaruszone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se apenas a chaves de licença ativadas e a produtos físicos. As chaves entregues, mas não ativadas, não são reembolsadas voluntariamente. Os direitos de garantia legal mantêm-se inalterados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller endast aktiverade licensnycklar och fysiska varor. För levererade men inte aktiverade nycklar görs ingen frivillig återbetalning. Lagstadgad reklamationsrätt påverkas inte."
          }
        }
      }
    },
