    "home.support.hours.label" : {
      "comment" : "Label of the service hours row in the support card; the hours follow after a dotted leader.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servicezeiten"
