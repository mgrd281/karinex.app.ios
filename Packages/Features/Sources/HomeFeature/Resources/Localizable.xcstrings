    "home.moneyback.title" : {
      "comment" : "Navigation title of the money-back conditions sheet, one line, max ~25 characters. Same wording as the trust fact \"home.trust.moneyback\". Glossary: 100 Tage Geld-zurück (EN 100-day money-back); never add \"guarantee\" or a similar word.",
      "extractionState" : "manual",
