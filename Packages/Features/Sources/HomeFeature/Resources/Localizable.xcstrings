    "home.trust.conditions" : {
      "comment" : "Text button below the money-back footnote on the Start tab. Opens the full money-back conditions.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedingungen anzeigen"
