    "home.moneyback.intro" : {
      "comment" : "Introduction at the top of the money-back conditions sheet, above the three conditions. One sentence. Glossary: Geld-zurück (EN money-back).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For ordningen med pengene tilbage gælder følgende betingelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Geld-zurück-Zusage gelten die folgenden Bedingungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following conditions apply to the money-back promise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El compromiso de reembolso está sujeto a las siguientes condiciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahat takaisin -lupaukseen sovelletaan seuraavia ehtoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’engagement de remboursement est soumis aux conditions suivantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’impegno di rimborso si applicano le seguenti condizioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor de geld-terugregeling gelden de volgende voorwaarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwrot pieniędzy obowiązuje na poniższych warunkach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compromisso de reembolso está sujeito às seguintes condições."
          }
        },
        "sv" : {
