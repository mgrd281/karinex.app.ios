        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show conditions"
          }
        }
      }
    },
    "home.trust.delivery" : {
      "comment" : "Trust fact tile on the Start tab: license keys are delivered by e-mail within minutes. Short, fits a half-width tile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieferung per E-Mail in Minuten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivery by e-mail in minutes"
          }
        }
      }
    },
    "home.trust.eyebrow" : {
      "comment" : "Small uppercase label above the trust facts section title on the Start tab.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut zu wissen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good to know"
          }
        }
      }
    },
    "home.trust.footnote" : {
      "comment" : "Footnote below the trust facts on the Start tab, preceded by the marker *. States the money-back condition: only activated keys and physical goods; delivered but unactivated keys are not refunded voluntarily; statutory warranty rights remain unaffected. Keep all three parts.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für aktivierte Lizenzschlüssel und physische Ware. Gelieferte, nicht aktivierte Schlüssel werden nicht freiwillig erstattet. Gesetzliche Gewährleistungsrechte bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies only to activated licence keys and physical goods. Delivered keys that have not been activated are not refunded voluntarily. Statutory warranty rights remain unaffected."
          }
        }
      }
    },
    "home.trust.moneyback" : {
      "comment" : "Trust fact tile on the Start tab: the 100-day money-back promise. The app appends a footnote marker (*) and a tap shows the conditions.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 Tage Geld-zurück"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100-day money-back"
          }
        }
      }
    },
    "home.trust.moneyback.hint" : {
      "comment" : "VoiceOver hint of the money-back trust tile, read after its text. Describes what a double tap does.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Bedingungen der Geld-zurück-Zusage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the conditions of the money-back promise."
          }
        }
      }
    },
