    "home.moneyback.clause.scope" : {
      "comment" : "First of three conditions in the money-back sheet (\"100 Tage Geld-zurück\"): the promise applies only to activated licence keys and to physical goods (USB sticks, discs). Keep the legal meaning exactly; do not soften \"only\". Wraps, no length limit.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordningen gælder kun for aktiverede licensnøgler og for fysiske varer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zusage gilt nur für aktivierte Lizenzschlüssel und für physische Ware."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The promise applies only to activated licence keys and to physical goods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este compromiso solo se aplica a claves de licencia activadas y a productos físicos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupaus koskee vain aktivoituja lisenssiavaimia ja fyysisiä tuotteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet engagement s’applique uniquement aux clés de licence activées et aux produits physiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impegno vale solo per i codici di licenza attivati e per i prodotti fisici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze regeling geldt alleen voor geactiveerde licentiesleutels en fysieke producten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwrot pieniędzy obejmuje wyłącznie aktywowane klucze licencyjne i towary fizyczne."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este compromisso aplica-se apenas a chaves de licença ativadas e a produtos físicos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löftet gäller endast för aktiverade licensnycklar och för fysiska varor."
          }
        }
      }
    },
    "home.moneyback.clause.statutory" : {
      "comment" : "Third condition in the money-back sheet: the customer's statutory warranty rights, for example for a defective key, are not affected. Use the standard legal phrase of your language for \"statutory rights are not affected\". Keep the legal meaning exactly. Wraps, no length limit.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lovbestemte reklamationsret, for eksempel ved en defekt nøgle, påvirkes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre gesetzlichen Gewährleistungsrechte, etwa bei einem fehlerhaften Schlüssel, bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your statutory warranty rights, for example for a defective key, are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus derechos de garantía legal, por ejemplo ante una clave defectuosa, no se ven afectados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakisääteiset oikeutesi virhetilanteissa, esimerkiksi virheellisen avaimen osalta, säilyvät ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos droits au titre de la garantie légale, par exemple en cas de clé défectueuse, ne sont pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restano salvi i tuoi diritti di garanzia legale, ad esempio in caso di codice difettoso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wettelijke garantierechten, bijvoorbeeld bij een defecte sleutel, blijven onverminderd van kracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje ustawowe uprawnienia z tytułu niezgodności z umową, np. w przypadku wadliwego klucza, pozostają nienaruszone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus direitos de garantia legal, por exemplo em caso de chave defeituosa, mantêm-se inalterados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lagstadgade reklamationsrätt, till exempel vid en felaktig nyckel, påverkas inte."
          }
        }
      }
    },
    "home.moneyback.clause.unactivated" : {
      "comment" : "Second condition in the money-back sheet: licence keys that have been delivered but not activated are not refunded voluntarily, because the key could still be used later. Keep the legal meaning exactly, including the reason. Wraps, no length limit.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leverede, men ikke aktiverede licensnøgler refunderes ikke frivilligt, da nøglen stadig ville kunne bruges senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelieferte, aber nicht aktivierte Lizenzschlüssel werden nicht freiwillig erstattet, da der Schlüssel später noch verwendet werden könnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence keys that have been delivered but not activated are not refunded voluntarily, as the key could still be used later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de licencia entregadas pero no activadas no se reembolsan de forma voluntaria, ya que la clave aún podría utilizarse más adelante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toimitettuja mutta aktivoimattomia lisenssiavaimia ei hyvitetä vapaaehtoisesti, koska avainta voitaisiin vielä käyttää myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de licence livrées mais non activées ne font pas l’objet d’un remboursement volontaire, car la clé pourrait encore être utilisée plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici di licenza consegnati ma non attivati non vengono rimborsati su base volontaria, poiché il codice potrebbe ancora essere utilizzato in seguito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleverde maar niet geactiveerde licentiesleutels komen niet in aanmerking voor vrijwillige terugbetaling, omdat de sleutel later nog gebruikt zou kunnen worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostarczone, ale nieaktywowane klucze licencyjne nie podlegają dobrowolnemu zwrotowi pieniędzy, ponieważ klucz mógłby jeszcze zostać użyty w przyszłości."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de licença entregues, mas não ativadas, não são reembolsadas voluntariamente, uma vez que a chave ainda poderia ser utilizada mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För levererade men inte aktiverade licensnycklar görs ingen frivillig återbetalning, eftersom nyckeln fortfarande skulle kunna användas senare."
          }
        }
      }
    },
