{
  "sourceLanguage" : "de",
  "strings" : {
    "home.hero.body" : {
      "comment" : "Introduction below the hero headline on the Start tab. Names the product range and the only three payment methods (Apple Pay, credit card, Klarna). Two sentences at most.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizenzschlüssel für Windows, Office und weitere Microsoft-Software. Bezahlen Sie mit Apple Pay, Kreditkarte oder Klarna und erhalten Sie Ihren Schlüssel per E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence keys for Windows, Office and other Microsoft software. Pay with Apple Pay, credit card or Klarna and receive your key by e-mail."
          }
        }
      }
    },
    "home.hero.cta" : {
      "comment" : "Primary button in the Start tab hero. Opens the Shop tab with the product range. Short verb phrase.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Sortiment"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse the range"
          }
        }
      }
    },
    "home.hero.eyebrow" : {
      "comment" : "Small uppercase label above the hero headline on the Start tab. Two or three words.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software-Lizenzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software licences"
          }
        }
      }
    },
    "home.hero.title" : {
      "comment" : "Serif display headline of the editorial hero on the Start tab. Short and calm; no exclamation mark.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Software. Per E-Mail in Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your software. By e-mail in minutes."
          }
        }
      }
    },
    "home.moneyback.clause.scope" : {
      "comment" : "First money-back condition: the promise covers only activated license keys and physical goods. Legal meaning must be kept exactly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zusage gilt nur für aktivierte Lizenzschlüssel und für physische Ware."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The promise applies only to activated licence keys and to physical goods."
          }
        }
      }
    },
    "home.moneyback.clause.statutory" : {
      "comment" : "Third money-back condition: statutory warranty rights, for example for a defective key, are not affected. Legal meaning must be kept exactly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre gesetzlichen Gewährleistungsrechte, etwa bei einem fehlerhaften Schlüssel, bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your statutory warranty rights, for example for a defective key, remain unaffected."
          }
        }
      }
    },
    "home.moneyback.clause.unactivated" : {
      "comment" : "Second money-back condition: delivered but not activated license keys are not refunded voluntarily, because the key could still be used later. Legal meaning must be kept exactly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelieferte, aber nicht aktivierte Lizenzschlüssel werden nicht freiwillig erstattet, da der Schlüssel später noch verwendet werden könnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivered licence keys that have not been activated are not refunded voluntarily, because the key could still be used later."
          }
        }
      }
    },
    "home.moneyback.done" : {
      "comment" : "Button in the top bar of the money-back conditions sheet that closes the sheet. One word.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        }
      }
    },
    "home.moneyback.intro" : {
      "comment" : "Introduction at the top of the money-back conditions sheet, above the list of conditions.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Geld-zurück-Zusage gelten die folgenden Bedingungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following conditions apply to the money-back promise."
          }
        }
      }
    },
    "home.moneyback.title" : {
      "comment" : "Navigation title of the sheet with the money-back conditions. Same wording as the trust fact.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 Tage Geld-zurück"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100-day money-back"
          }
        }
      }
    },
