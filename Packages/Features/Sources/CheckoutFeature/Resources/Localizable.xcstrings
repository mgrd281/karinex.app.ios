          "stringUnit" : {
            "state" : "translated",
            "value" : "Kassesessionen er udløbet. Prøv igen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de pago ha caducado. Inténtalo de nuevo."
          }
        },
