    "search.no_results.message %@" : {
      "comment" : "Message when a search finds nothing. %@ is the search text, in quotation marks of the language.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für „%@“ wurde nichts gefunden. Versuchen Sie einen anderen Begriff oder wählen Sie eine Kategorie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was found for “%@”. Try another term or choose a category."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono wyników dla „%@”. Spróbuj użyć innej frazy lub wybierz kategorię."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor “%@” is niets gevonden. Probeer een andere zoekterm of kies een categorie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi encontrado nada para «%@». Experimente outro termo ou escolha uma categoria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget hittades för ”%@”. Prova ett annat sökord eller välj en kategori."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet noget for »%@«. Prøv et andet søgeord, eller vælg en kategori."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado nada para «%@». Prueba con otro término o elige una categoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun résultat pour « %@ ». Essayez un autre terme ou choisissez une catégorie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun risultato per «%@». Prova un altro termine o scegli una categoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haulla ”%@” ei löytynyt mitään. Kokeile toista hakusanaa tai valitse kategoria."
