{
  "sourceLanguage" : "de",
  "strings" : {
    "search.empty.message" : {
      "comment" : "Text below the placeholder title on the search tab while search is not yet available in the app: customers will be able to search for products, categories and guides (how-to articles). No dates and no promises. Max ~90 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kan du fremover søge efter produkter, kategorier og vejledninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier suchen Sie künftig nach Produkten, Kategorien und Ratgebern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is where you will be able to search for products, categories and guides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí podrás buscar productos, categorías y guías."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täällä voit jatkossa hakea tuotteita, kategorioita ja oppaita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez ici rechercher des produits, des catégories et des guides pratiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui potrai cercare prodotti, categorie e guide."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier kun je in de toekomst zoeken naar producten, categorieën en handleidingen."
