    "commerce.market.reason.country" : {
      "comment" : "Info banner in the market sheet when the store does not sell to the device's region and another country was preselected. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir liefern derzeit nicht in Ihre Region. Wir haben ein anderes Land vorausgewählt, das Sie unten ändern können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We do not currently deliver to your region. We have preselected another country, which you can change below."
          }
        }
      }
    },
    "commerce.market.reason.country_and_language" : {
      "comment" : "Info banner in the market sheet when neither the device region nor its language is available and both were preselected. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Region und Ihre Sprache sind nicht verfügbar. Wir haben ein Land und eine Sprache vorausgewählt, die Sie unten ändern können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your region and language are not available. We have preselected a country and a language, which you can change below."
          }
        }
      }
    },
    "commerce.market.reason.language" : {
      "comment" : "Info banner in the market sheet when the device language is not available for the selected country and another content language was preselected. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Sprache ist für dieses Land nicht verfügbar. Wir zeigen die Inhalte in einer verfügbaren Sprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your language is not available for this country. We show the content in an available language."
          }
        }
      }
    },
