{
  "sourceLanguage" : "de",
  "strings" : {
    "commerce.article.byline %@ %@" : {
      "comment" : "Line below an article title: the publication date (first %@, e.g. \"24. Oktober 2026\") and the author name (second %@). Keep the order natural for the language; use positional specifiers (%1$@, %2$@) if you reorder.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, von %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, by %2$@"
          }
        }
      }
    },
    "commerce.article.empty.message" : {
