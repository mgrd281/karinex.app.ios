    "commerce.cart.expired" : {
      "comment" : "Error message when the customer taps \"Zur Kasse\" but the stored Shopify basket has expired or was already completed. The app emptied the basket; the customer has to add the products again. Shown below the title \"commerce.error.rejected.title\". Two short sentences, formal address. Glossary: Warenkorb (EN basket).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Warenkorb ist abgelaufen. Bitte legen Sie die Artikel erneut in den Warenkorb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your basket has expired. Please add the items to your basket again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój koszyk wygasł. Dodaj produkty do koszyka ponownie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je winkelwagen is verlopen. Voeg de artikelen opnieuw toe aan je winkelwagen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu carrinho expirou. Adicione novamente os artigos ao carrinho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din varukorg har gått ut. Lägg artiklarna i varukorgen igen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din kurv er udløbet. Læg varerne i kurven igen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cesta ha caducado. Vuelve a añadir los artículos a la cesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre panier a expiré. Veuillez ajouter de nouveau les articles à votre panier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo carrello è scaduto. Aggiungi di nuovo gli articoli al carrello."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostoskorisi on vanhentunut. Lisää tuotteet ostoskoriin uudelleen."
          }
        }
      }
    },
