    "commerce.market.reason.country" : {
      "comment" : "Info banner in the market sheet when the store does not sell to the device's region and another country was preselected. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir liefern derzeit nicht in Ihre Region. Wir haben ein anderes Land vorausgewählt, das Sie unten ändern können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We do not currently deliver to your region. We have preselected another country, which you can change below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecnie nie dostarczamy do Twojego regionu. Wybraliśmy inny kraj, który możesz zmienić poniżej."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We leveren momenteel niet in jouw regio. We hebben alvast een ander land gekozen, dat je hieronder kunt wijzigen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualmente, não entregamos na sua região. Pré-selecionámos outro país, que pode alterar abaixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi levererar för närvarande inte till din region. Vi har förvalt ett annat land som du kan ändra nedan."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi leverer i øjeblikket ikke til din region. Vi har forvalgt et andet land, som du kan ændre nedenfor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualmente no realizamos envíos a tu región. Hemos preseleccionado otro país, que puedes cambiar más abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne livrons pas actuellement dans votre région. Nous avons présélectionné un autre pays, que vous pouvez modifier ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non consegniamo nella tua regione. Abbiamo preselezionato un altro paese, che puoi modificare qui sotto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme tällä hetkellä toimita alueellesi. Olemme esivalinneet toisen maan, jonka voit vaihtaa alla."
          }
        }
      }
    },
    "commerce.market.reason.country_and_language" : {
      "comment" : "Info banner in the market sheet when neither the device region nor its language is available and both were preselected. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
