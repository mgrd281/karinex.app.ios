    "licenses.footnote" : {
      "comment" : "Footnote below the key cards. The clipboard lifetime is two minutes (KXClipboard).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizenzschlüssel werden nur auf diesem Gerät gespeichert und beim Abmelden entfernt. Beim Kopieren werden sie nach zwei Minuten aus der Zwischenablage gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence keys are stored only on this device and removed when you sign out. When copied, they are deleted from the clipboard after two minutes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze licencyjne są przechowywane tylko na tym urządzeniu i usuwane po wylogowaniu. Skopiowane klucze są usuwane ze schowka po dwóch minutach."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licentiesleutels worden alleen op dit apparaat bewaard en bij het afmelden verwijderd. Gekopieerde sleutels worden na twee minuten van het klembord verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de licença são guardadas apenas neste dispositivo e removidas ao terminar a sessão. Quando copiadas, são apagadas da área de transferência após dois minutos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licensnycklar sparas bara på den här enheten och tas bort när du loggar ut. Kopierade nycklar raderas från urklipp efter två minuter."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licensnøgler gemmes kun på denne enhed og fjernes, når du logger ud. Kopierede nøgler slettes fra udklipsholderen efter to minutter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de licencia solo se guardan en este dispositivo y se eliminan al cerrar sesión. Al copiarlas, se borran del portapapeles después de dos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de licence sont enregistrées uniquement sur cet appareil et supprimées à la déconnexion. Une fois copiées, elles sont effacées du presse-papiers après deux minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici di licenza vengono salvati solo su questo dispositivo e rimossi quando esci. Una volta copiati, vengono cancellati dagli appunti dopo due minuti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisenssiavaimet tallennetaan vain tähän laitteeseen ja poistetaan uloskirjautuessa. Kopioidut avaimet poistetaan leikepöydältä kahden minuutin kuluttua."
          }
        }
      }
    },
