{
  "sourceLanguage" : "de",
  "strings" : {
    "licenses.email.notice" : {
      "comment" : "Banner in the license vault while the app cannot load keys from the backend (PROMPT.md 12 fallback).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Lizenzschlüssel wurde per E-Mail zugestellt. Bitte sehen Sie in der E-Mail zu Ihrer Bestellung nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your licence key has been delivered by e-mail. Please check the e-mail for your order."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój klucz licencyjny został dostarczony e-mailem. Sprawdź wiadomość dotyczącą zamówienia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je licentiesleutel is per e-mail bezorgd. Bekijk de e-mail over je bestelling."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua chave de licença foi entregue por e-mail. Consulte o e-mail da sua encomenda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din licensnyckel har levererats via e-post. Titta i e-postmeddelandet om din beställning."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din licensnøgle er leveret via e-mail. Se e-mailen om din ordre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de licencia se ha entregado por correo electrónico. Consulta el correo de tu pedido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé de licence vous a été envoyée par e-mail. Consultez l’e-mail relatif à votre commande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo codice di licenza è stato consegnato via e-mail. Controlla l’e-mail relativa al tuo ordine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisenssiavaimesi on toimitettu sähköpostitse. Katso tilaustasi koskeva sähköposti."
          }
        }
      }
    },
    "licenses.empty.message" : {
      "comment" : "Empty state of the license vault.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Ihre Lizenzschlüssel, sobald sie zugestellt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your licence keys appear here once they have been delivered."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się Twoje klucze licencyjne, gdy zostaną dostarczone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier verschijnen je licentiesleutels zodra ze zijn bezorgd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas chaves de licença aparecem aqui assim que forem entregues."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Här visas dina licensnycklar när de har levererats."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her vises dine licensnøgler, når de er leveret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecerán tus claves de licencia cuando se hayan entregado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos clés de licence apparaissent ici dès qu’elles ont été livrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compariranno i tuoi codici di licenza non appena saranno consegnati."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisenssiavaimesi näkyvät täällä, kun ne on toimitettu."
          }
        }
      }
    },
