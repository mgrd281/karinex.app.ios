    "licenses.locked.message" : {
      "comment" : "Message of the locked vault.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren Sie Ihre Lizenzschlüssel mit Face ID, Touch ID oder Ihrem Gerätecode."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your licence keys with Face ID, Touch ID or your device passcode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj klucze licencyjne za pomocą Face ID, Touch ID lub kodu urządzenia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel je licentiesleutels met Face ID, Touch ID of de toegangscode van je apparaat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie as suas chaves de licença com Face ID, Touch ID ou o código do dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås upp dina licensnycklar med Face ID, Touch ID eller enhetens lösenkod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås dine licensnøgler op med Face ID, Touch ID eller enhedens adgangskode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea tus claves de licencia con Face ID, Touch ID o el código del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez vos clés de licence avec Face ID, Touch ID ou le code de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
