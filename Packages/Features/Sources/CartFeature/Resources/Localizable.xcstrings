{
  "sourceLanguage" : "de",
  "strings" : {
    "cart.checkout" : {
      "comment" : "Primary full-width button at the bottom of the basket that opens the Shopify checkout. Max ~25 characters. Glossary: Kasse (EN checkout).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Kasse"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to checkout"
          }
        }
      }
    },
    "cart.crosssell.title" : {
      "comment" : "Serif section title above a horizontal row of products that go well with the first product in the basket (Shopify's complementary recommendations). Max ~25 characters. Makes no claim about the products.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passend dazu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goes well with"
          }
        }
      }
    },
    "cart.discount.active" : {
      "comment" : "Small badge next to a discount code in the basket that the store applies. One or two words, max ~15 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiv"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applied"
          }
        }
      }
    },
    "cart.discount.applied %@" : {
      "comment" : "Confirmation below the discount code field after the store accepted a code. %@ is the code the customer typed, e.g. \"WILLKOMMEN\". One sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code %@ wurde angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code %@ has been applied."
          }
        }
      }
    },
    "cart.discount.apply" : {
      "comment" : "Button next to the discount code field that sends the code to the store. Short verb, max ~12 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply"
          }
        }
      }
    },
    "cart.discount.inactive" : {
      "comment" : "Small badge next to a discount code in the basket that the store does not apply to this basket. Max ~18 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gültig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not applicable"
          }
        }
      }
    },
    "cart.discount.not_applicable" : {
      "comment" : "Message below the discount code field when the store does not apply the code to this basket and sent no explanation of its own. One sentence, neutral.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code gilt nicht für Ihren Warenkorb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code does not apply to your basket."
          }
        }
      }
    },
