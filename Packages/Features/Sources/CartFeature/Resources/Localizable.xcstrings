    "cart.notice.digital" : {
      "comment" : "Legal footnote at the bottom of the basket: for digital content (licence keys) the right of withdrawal expires once delivery begins with the customer's express consent. Keep the legal meaning exactly. German cites \"§ 356 Abs. 5 BGB\"; every other language states the rule neutrally and does not cite German law (docs/LOCALIZATION.md, tone rule 6). No length limit; the text wraps. Glossary: Widerrufsrecht (EN right of withdrawal).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For digitalt indhold bortfalder din fortrydelsesret, så snart leveringen begynder med dit udtrykkelige samtykke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei digitalen Inhalten erlischt Ihr Widerrufsrecht, sobald die Lieferung mit Ihrer ausdrücklichen Zustimmung beginnt (§ 356 Abs. 5 BGB)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For digital content, the right of withdrawal ends once delivery starts with your express consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el caso de contenidos digitales, tu derecho de desistimiento se extingue en cuanto comienza la entrega con tu consentimiento expreso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitaalisen sisällön osalta peruuttamisoikeutesi päättyy heti, kun toimitus alkaa nimenomaisella suostumuksellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les contenus numériques, votre droit de rétractation prend fin dès que la livraison commence avec votre consentement exprès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i contenuti digitali, il tuo diritto di recesso si estingue non appena la consegna inizia con il tuo consenso espresso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij digitale inhoud vervalt je herroepingsrecht zodra de levering met je uitdrukkelijke toestemming begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku treści cyfrowych prawo odstąpienia od umowy wygasa z chwilą rozpoczęcia dostawy za Twoją wyraźną zgodą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No caso de conteúdos digitais, o seu direito de livre resolução extingue-se assim que a entrega tiver início com o seu consentimento expresso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För digitalt innehåll upphör din ångerrätt så snart leveransen påbörjas med ditt uttryckliga samtycke."
          }
        }
      }
    },
