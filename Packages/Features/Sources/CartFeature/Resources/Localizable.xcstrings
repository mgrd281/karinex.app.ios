{
  "sourceLanguage" : "de",
  "strings" : {
    "cart.empty.action" : {
      "comment" : "Primary full-width button in the empty basket state; opens the Shop tab with the product range. Short verb phrase, one line, max ~25 characters. Same text as \"home.hero.cta\" on the Start tab; translate both identically. Glossary: Sortiment (EN range).",
      "extractionState" : "manual",
      "localizations" : {
