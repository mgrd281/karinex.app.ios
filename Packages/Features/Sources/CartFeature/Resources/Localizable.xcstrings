    "cart.empty.message" : {
      "comment" : "Text below the empty basket title: products the customer adds to the basket will be listed here. One sentence, max ~70 characters. Glossary: Warenkorb (EN basket).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produkter, du lægger i kurven, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produkte, die Sie in den Warenkorb legen, finden Sie hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Products you add to your basket will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los productos que añadas a la cesta aparecerán aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostoskoriin lisäämäsi tuotteet näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les produits que vous ajoutez au panier apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prodotti che aggiungi al carrello appariranno qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Producten die je aan je winkelwagen toevoegt, vind je hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się produkty dodane do koszyka."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os produtos que adicionar ao carrinho aparecem aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produkter som du lägger i varukorgen visas här."
          }
        }
      }
    },
