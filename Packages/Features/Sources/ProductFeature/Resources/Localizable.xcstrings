    "product.notice.digital" : {
      "comment" : "Notice for digital products. German cites § 356 Abs. 5 BGB; other languages describe the rule neutrally without citing German law.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei digitalen Inhalten erlischt Ihr Widerrufsrecht, sobald die Lieferung mit Ihrer ausdrücklichen Zustimmung beginnt (§ 356 Abs. 5 BGB)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For digital content, the right of withdrawal ends once delivery starts with your express consent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku treści cyfrowych prawo odstąpienia od umowy wygasa, gdy dostawa rozpocznie się za Twoją wyraźną zgodą."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij digitale inhoud vervalt het herroepingsrecht zodra de levering met jouw uitdrukkelijke toestemming begint."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No caso de conteúdos digitais, o direito de livre resolução cessa assim que a entrega começa com o seu consentimento expresso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För digitalt innehåll upphör ångerrätten när leveransen påbörjas med ditt uttryckliga samtycke."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For digitalt indhold bortfalder fortrydelsesretten, når leveringen påbegyndes med dit udtrykkelige samtykke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el caso de contenidos digitales, el derecho de desistimiento se extingue cuando la entrega comienza con tu consentimiento expreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les contenus numériques, le droit de rétractation prend fin dès que la livraison commence avec votre accord exprès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i contenuti digitali, il diritto di recesso si estingue quando la consegna inizia con il tuo consenso espresso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitaalisen sisällön osalta peruuttamisoikeus raukeaa, kun toimitus alkaa nimenomaisella suostumuksellasi."
          }
        }
      }
    },
