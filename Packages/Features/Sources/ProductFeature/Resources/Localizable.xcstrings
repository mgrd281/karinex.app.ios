    "product.refund.scope" : {
      "comment" : "Condition 1 of the money-back promise, shown right below it. Must state that it applies only to activated licence keys and physical goods.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zusage gilt nur für aktivierte Lizenzschlüssel und für physische Ware."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The promise applies only to activated licence keys and to physical goods."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobowiązanie dotyczy wyłącznie aktywowanych kluczy licencyjnych i towarów fizycznych."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toezegging geldt alleen voor geactiveerde licentiesleutels en fysieke artikelen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compromisso aplica-se apenas a chaves de licença ativadas e a artigos físicos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löftet gäller endast aktiverade licensnycklar och fysiska varor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilsagnet gælder kun aktiverede licensnøgler og fysiske varer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La promesa solo se aplica a las claves de licencia activadas y a los artículos físicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’engagement ne s’applique qu’aux clés de licence activées et aux articles physiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impegno vale solo per i codici di licenza attivati e per i prodotti fisici."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupaus koskee vain aktivoituja lisenssiavaimia ja fyysisiä tuotteita."
          }
        }
      }
    },
    "product.refund.statutory" : {
      "comment" : "Condition 3 of the money-back promise: statutory warranty rights are not affected.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre gesetzlichen Gewährleistungsrechte, etwa bei einem fehlerhaften Schlüssel, bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your statutory warranty rights, for example for a defective key, are not affected."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje ustawowe prawa z tytułu rękojmi, na przykład w przypadku wadliwego klucza, pozostają nienaruszone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wettelijke garantierechten, bijvoorbeeld bij een defecte sleutel, blijven onverlet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus direitos legais de garantia, por exemplo no caso de uma chave defeituosa, mantêm-se inalterados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina lagstadgade garantirättigheter, till exempel vid en felaktig nyckel, påverkas inte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine lovbestemte garantirettigheder, for eksempel ved en defekt nøgle, berøres ikke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus derechos legales de garantía, por ejemplo ante una clave defectuosa, no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos droits légaux de garantie, par exemple en cas de clé défectueuse, ne sont pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi diritti legali di garanzia, ad esempio in caso di codice difettoso, restano invariati."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakisääteiset takuuoikeutesi, esimerkiksi viallisen avaimen tapauksessa, eivät muutu."
          }
        }
      }
    },
