    "product.refund.unactivated" : {
      "comment" : "Condition 2 of the money-back promise: delivered keys that were not activated are not refunded voluntarily. Keep the reason.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelieferte, aber nicht aktivierte Lizenzschlüssel werden nicht freiwillig erstattet, da der Schlüssel später noch verwendet werden könnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence keys that have been delivered but not activated are not refunded voluntarily, as the key could still be used later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostarczone, ale nieaktywowane klucze licencyjne nie są zwracane dobrowolnie, ponieważ klucz mógłby zostać wykorzystany później."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleverde maar niet geactiveerde licentiesleutels worden niet vrijwillig terugbetaald, omdat de sleutel later nog gebruikt zou kunnen worden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de licença entregues, mas não ativadas, não são reembolsadas a título voluntário, uma vez que a chave ainda poderia ser utilizada mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levererade men inte aktiverade licensnycklar återbetalas inte frivilligt, eftersom nyckeln fortfarande kan användas senare."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leverede, men ikke aktiverede licensnøgler refunderes ikke frivilligt, da nøglen stadig kunne bruges senere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de licencia entregadas pero no activadas no se reembolsan de forma voluntaria, ya que la clave aún podría utilizarse más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés de licence livrées mais non activées ne sont pas remboursées de manière volontaire, car la clé pourrait encore être utilisée ultérieurement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici di licenza consegnati ma non attivati non vengono rimborsati volontariamente, poiché il codice potrebbe ancora essere utilizzato in seguito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toimitettuja mutta aktivoimattomia lisenssiavaimia ei hyvitetä vapaaehtoisesti, koska avainta voitaisiin vielä käyttää myöhemmin."
          }
        }
      }
    },
