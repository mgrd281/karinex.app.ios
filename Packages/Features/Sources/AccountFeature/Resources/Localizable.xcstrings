    "account.invoices.empty.message" : {
      "comment" : "Text when the customer has no invoice yet: invoices appear here once an order is paid, and also come by e-mail. One or two sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald eine Bestellung bezahlt ist, finden Sie die Rechnung hier. Sie erhalten sie außerdem per E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as an order is paid, you will find the invoice here. You also receive it by e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zamówienie zostanie opłacone, znajdziesz tu fakturę. Otrzymasz ją także e-mailem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra een bestelling is betaald, vind je de factuur hier. Je ontvangt hem ook per e-mail."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim que uma encomenda for paga, encontrará aqui a fatura. Também a recebe por e-mail."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en beställning är betald hittar du fakturan här. Du får den även via e-post."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så snart en ordre er betalt, finder du fakturaen her. Du modtager den også på e-mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cuanto se pague un pedido, encontrarás aquí la factura. También la recibirás por correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès qu’une commande est payée, vous trouvez la facture ici. Vous la recevez aussi par e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non appena un ordine è pagato, trovi qui la fattura. La ricevi anche via e-mail."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tilaus on maksettu, löydät laskun täältä. Saat sen myös sähköpostiisi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De îndată ce o comandă este plătită, factura apare aici. O primiți și prin e-mail."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις πληρωθεί μια παραγγελία, το τιμολόγιο εμφανίζεται εδώ. Το λαμβάνετε επίσης μέσω email."
          }
        }
      }
    },
