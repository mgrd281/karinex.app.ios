    "account.loyalty.balance.footer" : {
      "comment" : "Footer under the balances. Explains the two kinds of points.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuspunkte bestimmen Ihre Stufe und werden nie ausgegeben. Prämienpunkte können Sie gegen Rabatte einlösen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status points set your level and are never spent. Reward points can be redeemed for discounts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty statusu określają Twój poziom i nigdy nie są wydawane. Punkty nagród możesz wymienić na rabaty."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuspunten bepalen uw niveau en worden nooit uitgegeven. Beloningspunten kunt u inwisselen voor korting."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pontos de estatuto definem o seu nível e nunca são gastos. Os pontos de prémio podem ser trocados por descontos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuspoäng avgör din nivå och används aldrig. Belöningspoäng kan du lösa in mot rabatter."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuspoint bestemmer dit niveau og bruges aldrig. Præmiepoint kan du indløse til rabatter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos de estatus fijan su nivel y nunca se gastan. Los puntos de premio se pueden canjear por descuentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points de statut déterminent votre niveau et ne sont jamais dépensés. Les points de récompense peuvent être échangés contre des remises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I punti status determinano il suo livello e non vengono mai spesi. I punti premio si possono riscattare in sconti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuspisteet määräävät tasosi, eikä niitä kuluteta. Palkintopisteet voit vaihtaa alennuksiin."
          }
        }
      }
    },
