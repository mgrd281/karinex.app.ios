    "account.loyalty.confirm.message %@ %lld %lld" : {
      "comment" : "Message of the confirmation dialog with the conditions. First %@ the smallest value of goods in euros, then the largest share of the goods in percent (write a literal percent sign as %%), then the days the code is valid.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt ab %@ Warenwert, für höchstens %lld %% der Ware und ohne Versand. Der Code ist %lld Tage gültig und nur für Sie. Die Punkte werden jetzt abgezogen. Verfällt der Code ungenutzt, werden sie wieder gutgeschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valid from %@ in goods, for at most %lld %% of the goods and without shipping. The code is valid for %lld days and only for you. The points are deducted now. If the code expires unused, they are credited back."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ważny od %@ wartości towarów, na najwyżej %lld %% towarów i bez wysyłki. Kod jest ważny przez %lld dni i tylko dla Ciebie. Punkty zostaną teraz odjęte. Jeśli kod wygaśnie niewykorzystany, punkty wrócą na konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldig vanaf %@ aan producten, voor maximaal %lld %% van de producten en zonder verzending. De code is %lld dagen geldig en alleen voor u. De punten worden nu afgeschreven. Vervalt de code ongebruikt, dan worden ze weer bijgeschreven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válido a partir de %@ em artigos, para no máximo %lld %% dos artigos e sem portes. O código é válido durante %lld dias e só para si. Os pontos são descontados agora. Se o código expirar sem ser usado, são devolvidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller från %@ i varor, för högst %lld %% av varorna och utan frakt. Koden är giltig i %lld dagar och bara för dig. Poängen dras av nu. Om koden går ut oanvänd återfår du dem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder fra %@ i varer, for højst %lld %% af varerne og uden fragt. Koden er gyldig i %lld dage og kun til dig. Pointene trækkes nu. Udløber koden ubrugt, får du dem tilbage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válido desde %@ en productos, para como máximo el %lld %% de los productos y sin envío. El código es válido durante %lld días y solo para usted. Los puntos se descuentan ahora. Si el código caduca sin usarse, se le devuelven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valable dès %@ d'articles, pour au plus %lld %% des articles et hors livraison. Le code est valable %lld jours et uniquement pour vous. Les points sont déduits maintenant. Si le code expire sans être utilisé, ils vous sont recrédités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valido da %@ di merce, per al massimo il %lld %% della merce e senza spedizione. Il codice è valido per %lld giorni e solo per lei. I punti vengono detratti ora. Se il codice scade inutilizzato, i punti vengono riaccreditati."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voimassa vähintään %@ tuotteille, enintään %lld %% tuotteista ja ilman toimituskuluja. Koodi on voimassa %lld päivää ja vain sinulle. Pisteet vähennetään nyt. Jos koodi vanhenee käyttämättä, pisteet palautetaan."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valabil de la o valoare a produselor de %@, pentru cel mult %lld %% din produse și fără livrare. Codul este valabil %lld zile și doar pentru dumneavoastră. Punctele se scad acum. Dacă codul expiră nefolosit, punctele vă sunt returnate."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει από αξία προϊόντων %@, για έως %lld %% των προϊόντων και χωρίς τα έξοδα αποστολής. Ο κωδικός ισχύει %lld ημέρες και μόνο για εσάς. Οι πόντοι αφαιρούνται τώρα. Αν ο κωδικός λήξει αχρησιμοποίητος, οι πόντοι πιστώνονται ξανά."
          }
        }
      }
    },
