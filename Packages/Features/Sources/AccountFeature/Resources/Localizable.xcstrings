    "account.delete.intro" : {
      "comment" : "First paragraph of the deletion screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihr Konto löschen, werden Ihre Kundendaten bei KARINEX gelöscht und Sie werden abgemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you delete your account, your customer data at KARINEX will be deleted and you will be signed out."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli usuniesz konto, Twoje dane klienta w KARINEX zostaną usunięte, a sesja zostanie zakończona."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je account verwijdert, worden je klantgegevens bij KARINEX verwijderd en word je afgemeld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminar a sua conta, os seus dados de cliente na KARINEX serão eliminados e a sessão será terminada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar ditt konto raderas dina kunduppgifter hos KARINEX och du loggas ut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter din konto, slettes dine kundedata hos KARINEX, og du bliver logget ud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliminas tu cuenta, tus datos de cliente en KARINEX se eliminarán y se cerrará tu sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous supprimez votre compte, vos données client chez KARINEX seront supprimées et vous serez déconnecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimini il tuo account, i tuoi dati cliente presso KARINEX verranno eliminati e la sessione verrà chiusa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos poistat tilisi, asiakastietosi poistetaan KARINEXilta ja sinut kirjataan ulos."
