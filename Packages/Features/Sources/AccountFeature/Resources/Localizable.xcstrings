    "account.loyalty.rewards.footer %lld %@ %lld" : {
      "comment" : "Footer under the rewards. First %lld the largest share of the goods in percent, %@ the smallest value of goods in euros, last %lld the days a code stays valid. Write a literal percent sign as %%.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rabatt deckt höchstens %lld %% des Warenwerts ab und gilt ab einem Warenwert von %@ (ohne Versand). Der Code ist %lld Tage gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
