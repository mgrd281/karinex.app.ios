    "account.loyalty.code.footer" : {
      "comment" : "Footer on the code sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code gehört zu Ihrem Konto und kann einmal verwendet werden. Notieren Sie ihn, falls Sie ihn später nutzen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code belongs to your account and can be used once. Note it down if you want to use it later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod należy do Twojego konta i można go użyć raz. Zapisz go, jeśli chcesz użyć go później."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De code hoort bij uw account en kan één keer worden gebruikt. Noteer hem als u hem later wilt gebruiken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código pertence à sua conta e só pode ser usado uma vez. Anote-o se quiser usá-lo mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden hör till ditt konto och kan användas en gång. Anteckna den om du vill använda den senare."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden hører til din konto og kan bruges én gang. Skriv den ned, hvis du vil bruge den senere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código pertenece a su cuenta y se puede usar una vez. Anótelo si desea usarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code est lié à votre compte et ne peut être utilisé qu'une fois. Notez-le si vous souhaitez l'utiliser plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice appartiene al suo account e può essere usato una sola volta. Lo annoti se desidera usarlo più tardi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodi kuuluu tilillesi ja sen voi käyttää kerran. Kirjoita se muistiin, jos haluat käyttää sitä myöhemmin."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codul aparține contului dumneavoastră și poate fi folosit o singură dată. Notați-l dacă doriți să îl folosiți mai târziu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός ανήκει στον λογαριασμό σας και μπορεί να χρησιμοποιηθεί μία φορά. Σημειώστε τον, αν θέλετε να τον χρησιμοποιήσετε αργότερα."
          }
        }
      }
    },
