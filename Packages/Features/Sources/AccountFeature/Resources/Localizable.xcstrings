    "account.loyalty.discount.footer %lld" : {
      "comment" : "Footer of the permanent discount section. %lld is the number of months.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit niveau følger dine køb fra de seneste %lld måneder. Rabatten gælder også sammen med en kode fra dine bonuspoint."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Stufe richtet sich nach Ihren Einkäufen der letzten %lld Monate. Der Rabatt gilt zusätzlich zu einem Code aus Ihren Prämienpunkten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your level follows your purchases of the last %lld months. The discount also works together with a code from your reward points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su nivel depende de sus compras de los últimos %lld meses. El descuento también se suma a un código de sus puntos de premio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasosi määräytyy viimeisten %lld kuukauden ostojesi mukaan. Alennus toimii myös yhdessä palkintopisteistä saadun koodin kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre niveau dépend de vos achats des %lld derniers mois. La remise s’ajoute aussi à un code issu de vos points de récompense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo livello dipende dagli acquisti degli ultimi %lld mesi. Lo sconto vale anche insieme a un codice dai suoi punti premio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw niveau volgt uw aankopen van de afgelopen %lld maanden. De korting geldt ook samen met een code uit uw beloningspunten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój poziom zależy od zakupów z ostatnich %lld miesięcy. Rabat działa także razem z kodem z punktów nagród."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu nível depende das suas compras dos últimos %lld meses. O desconto também funciona com um código dos seus pontos de recompensa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nivå följer dina köp de senaste %lld månaderna. Rabatten gäller även tillsammans med en kod från dina bonuspoäng."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivelul dumneavoastră depinde de achizițiile din ultimele %lld luni. Reducerea se aplică în plus față de un cod obținut din punctele de recompensă."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το επίπεδό σας εξαρτάται από τις αγορές των τελευταίων %lld μηνών. Η έκπτωση ισχύει επιπλέον ενός κωδικού από τους πόντους ανταμοιβής σας."
          }
        }
      }
    },
