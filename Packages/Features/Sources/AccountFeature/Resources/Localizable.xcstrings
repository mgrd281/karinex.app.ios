    "account.loyalty.code.footer" : {
      "comment" : "Footer on the code sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code gehört zu Ihrem Konto und kann einmal verwendet werden. Notieren Sie ihn, falls Sie ihn später nutzen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code belongs to your account and can be used once. Note it down if you want to use it later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod należy do Twojego konta i można go użyć raz. Zapisz go, jeśli chcesz użyć go później."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
