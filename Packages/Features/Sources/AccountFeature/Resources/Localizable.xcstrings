    "account.profile.delete.subtitle" : {
      "comment" : "Short line under \"Konto und Daten löschen\": the customer account and stored data are removed on request. Max ~60 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Kundenkonto und Ihre gespeicherten Daten entfernen lassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have your customer account and stored data removed"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń konto klienta i zapisane dane"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je klantaccount en opgeslagen gegevens laten verwijderen"
          }
        },
        "pt-PT" : {
