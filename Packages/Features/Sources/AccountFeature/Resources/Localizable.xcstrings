    "account.profile.login.message" : {
      "comment" : "Text of the no-password note: every sign-in sends a code to the e-mail address, so there is no password to guess or steal. Two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jeder Anmeldung erhalten Sie einen Code an Ihre E-Mail-Adresse. So gibt es kein Passwort, das jemand erraten oder stehlen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time you sign in, you receive a code at your e-mail address. So there is no password that anyone could guess or steal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy każdym logowaniu otrzymujesz kod na swój adres e-mail. Dzięki temu nie ma hasła, które ktoś mógłby odgadnąć lub ukraść."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij elke keer inloggen ontvang je een code op je e-mailadres. Zo is er geen wachtwoord dat iemand kan raden of stelen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre que inicia sessão, recebe um código no seu endereço de e-mail. Assim não existe nenhuma palavra-passe que alguém possa adivinhar ou roubar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje gång du loggar in får du en kod till din e-postadress. Så finns det inget lösenord som någon kan gissa eller stjäla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du logger ind, modtager du en kode på din e-mailadresse. Så er der ingen adgangskode, som nogen kan gætte eller stjæle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que inicias sesión, recibes un código en tu correo electrónico. Así no hay ninguna contraseña que alguien pueda adivinar o robar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À chaque connexion, vous recevez un code à votre adresse e-mail. Il n’y a donc aucun mot de passe à deviner ou à voler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ogni accesso ricevi un codice al tuo indirizzo e-mail. Così non c’è nessuna password che qualcuno possa indovinare o rubare."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat jokaisella kirjautumiskerralla koodin sähköpostiisi. Näin ei ole salasanaa, jonka joku voisi arvata tai varastaa."
          }
        }
      }
    },
