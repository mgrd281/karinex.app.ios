    "account.delete.intro" : {
      "comment" : "First paragraph of the deletion screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Ihr Konto löschen, werden Ihre Kundendaten bei KARINEX gelöscht und Sie werden abgemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you delete your account, your customer data at KARINEX will be deleted and you will be signed out."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli usuniesz konto, Twoje dane klienta w KARINEX zostaną usunięte, a sesja zostanie zakończona."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je account verwijdert, worden je klantgegevens bij KARINEX verwijderd en word je afgemeld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminar a sua conta, os seus dados de cliente na KARINEX serão eliminados e a sessão será terminada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar ditt konto raderas dina kunduppgifter hos KARINEX och du loggas ut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter din konto, slettes dine kundedata hos KARINEX, og du bliver logget ud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliminas tu cuenta, tus datos de cliente en KARINEX se eliminarán y se cerrará tu sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous supprimez votre compte, vos données client chez KARINEX seront supprimées et vous serez déconnecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimini il tuo account, i tuoi dati cliente presso KARINEX verranno eliminati e la sessione verrà chiusa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos poistat tilisi, asiakastietosi poistetaan KARINEXilta ja sinut kirjataan ulos."
          }
        }
      }
    },
    "account.delete.keys" : {
      "comment" : "Hint to keep the license keys before deleting.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notieren Sie Ihre Lizenzschlüssel vorher. Sie stehen auch in den E-Mails, mit denen sie zugestellt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note down your licence keys first. They are also in the e-mails they were delivered with."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanotuj najpierw swoje klucze licencyjne. Znajdziesz je też w e-mailach, w których zostały dostarczone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteer eerst je licentiesleutels. Ze staan ook in de e-mails waarmee ze zijn bezorgd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote primeiro as suas chaves de licença. Também se encontram nos e-mails com que foram entregues."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteckna dina licensnycklar först. De finns också i e-postmeddelandena som de levererades med."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notér dine licensnøgler først. De står også i de e-mails, de blev leveret med."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota antes tus claves de licencia. También están en los correos con los que se entregaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez d’abord vos clés de licence. Elles figurent aussi dans les e-mails avec lesquels elles ont été livrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota prima i tuoi codici di licenza. Si trovano anche nelle e-mail con cui sono stati consegnati."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita lisenssiavaimesi ensin muistiin. Ne löytyvät myös sähköposteista, joilla ne toimitettiin."
          }
        }
      }
    },
    "account.delete.retention" : {
      "comment" : "Footnote on statutory retention (e.g. invoices).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten, die wir aus gesetzlichen Gründen aufbewahren müssen, etwa Rechnungen, werden erst nach Ablauf der Fristen gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data that we must keep for legal reasons, such as invoices, is deleted only when the retention periods end."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane, które musimy przechowywać ze względów prawnych, na przykład faktury, zostaną usunięte dopiero po upływie wymaganych okresów."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegevens die we om wettelijke redenen moeten bewaren, zoals facturen, worden pas na afloop van de bewaartermijnen verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados que temos de conservar por motivos legais, como as faturas, só são eliminados no fim dos prazos de conservação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppgifter som vi måste spara av rättsliga skäl, till exempel fakturor, raderas först när lagringstiden har löpt ut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data, som vi skal opbevare af juridiske årsager, for eksempel fakturaer, slettes først, når opbevaringsfristerne er udløbet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos que debemos conservar por motivos legales, como las facturas, solo se eliminan cuando terminan los plazos de conservación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données que nous devons conserver pour des raisons légales, comme les factures, ne sont supprimées qu’à l’expiration des délais de conservation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati che dobbiamo conservare per motivi di legge, come le fatture, vengono eliminati solo alla scadenza dei termini di conservazione."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedot, jotka meidän on säilytettävä lain vuoksi, kuten laskut, poistetaan vasta säilytysaikojen päätyttyä."
          }
        }
      }
    },
