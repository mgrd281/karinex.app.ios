    "account.wishlist.empty.message" : {
      "comment" : "Message of the empty wishlist; explains the heart button on product pages.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf einer Produktseite auf das Herz, um das Produkt hier zu sammeln. Die Merkliste bleibt auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the heart on a product page to keep the product here. The wishlist stays on this device."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij serce na stronie produktu, aby zapisać go tutaj. Lista życzeń pozostaje na tym urządzeniu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een productpagina op het hartje om het product hier te bewaren. De verlanglijst blijft op dit apparaat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no coração na página de um produto para o guardar aqui. A lista fica guardada neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på hjärtat på en produktsida för att spara produkten här. Önskelistan finns bara på den här enheten."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på hjertet på en produktside for at gemme produktet her. Ønskelisten bliver på denne enhed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el corazón en la página de un producto para guardarlo aquí. La lista se queda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le cœur sur la page d’un produit pour le retrouver ici. La liste reste sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il cuore nella pagina di un prodotto per salvarlo qui. La lista resta su questo dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna tuote tänne napauttamalla tuotesivun sydäntä. Toivelista säilyy tällä laitteella."
          }
        }
      }
    },
