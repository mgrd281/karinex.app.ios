    "account.loyalty.rewards.footer %lld %@ %lld" : {
      "comment" : "Footer under the rewards. First %lld the largest share of the goods in percent, %@ the smallest value of goods in euros, last %lld the days a code stays valid. Write a literal percent sign as %%.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rabatt deckt höchstens %lld %% des Warenwerts ab und gilt ab einem Warenwert von %@ (ohne Versand). Der Code ist %lld Tage gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The discount covers at most %lld %% of the value of goods and applies from %@ in goods (shipping excluded). The code is valid for %lld days."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rabat pokrywa najwyżej %lld %% wartości towarów i obowiązuje od %@ wartości towarów (bez wysyłki). Kod jest ważny przez %lld dni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De korting dekt maximaal %lld %% van de waarde van de producten en geldt vanaf %@ aan producten (exclusief verzending). De code is %lld dagen geldig."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desconto cobre no máximo %lld %% do valor dos artigos e aplica-se a partir de %@ em artigos (sem portes). O código é válido durante %lld dias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rabatten täcker högst %lld %% av varuvärdet och gäller från %@ i varor (exklusive frakt). Koden är giltig i %lld dagar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rabatten dækker højst %lld %% af varernes værdi og gælder fra %@ i varer (uden fragt). Koden er gyldig i %lld dage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El descuento cubre como máximo el %lld %% del valor de los productos y se aplica desde %@ en productos (sin envío). El código es válido durante %lld días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La remise couvre au plus %lld %% de la valeur des articles et s'applique dès %@ d'articles (hors livraison). Le code est valable %lld jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sconto copre al massimo il %lld %% del valore della merce e vale da %@ di merce (spedizione esclusa). Il codice è valido per %lld giorni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alennus kattaa enintään %lld %% tuotteiden arvosta ja koskee vähintään %@ tuotteita (ilman toimituskuluja). Koodi on voimassa %lld päivää."
          }
        }
      }
    },
