          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note down your licence keys first. They are also in the e-mails they were delivered with."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanotuj najpierw swoje klucze licencyjne. Znajdziesz je też w e-mailach, w których zostały dostarczone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
