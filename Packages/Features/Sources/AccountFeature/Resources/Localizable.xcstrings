    "account.delete.done.message" : {
      "comment" : "Shown after the backend accepted the deletion request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben Ihre Anfrage erhalten. Sie erhalten eine Bestätigung per E-Mail. Auf diesem Gerät sind Sie abgemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have received your request. You will receive a confirmation by e-mail. You have been signed out on this device."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymaliśmy Twoją prośbę. Otrzymasz potwierdzenie e-mailem. Sesja na tym urządzeniu została zakończona."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben je aanvraag ontvangen. Je ontvangt een bevestiging per e-mail. Op dit apparaat ben je afgemeld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
