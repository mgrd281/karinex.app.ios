        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta entonces los puntos están pendientes. En caso de devolución o reembolso se descuentan en consecuencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
