    "account.benefit.keys" : {
      "comment" : "Second account benefit in the list on the Konto tab (signed-out state), next to a key icon: licence keys are kept securely on this device (stored in the iOS keychain, not synced). Same verb style as \"account.benefit.orders\". One or two lines, max ~55 characters. Glossary: Lizenzschlüssel (EN licence key).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opbevar dine licensnøgler sikkert på denne enhed"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lizenzschlüssel sicher auf diesem Gerät aufbewahren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep licence keys securely on this device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar claves de licencia a salvo en este dispositivo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä lisenssiavaimesi turvassa tällä laitteella"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder vos clés de licence en sécurité sur cet appareil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservare al sicuro i codici di licenza sul dispositivo"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licentiesleutels veilig op dit apparaat bewaren"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze licencyjne zapisane bezpiecznie na tym urządzeniu"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar chaves de licença em segurança neste dispositivo"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvara dina licensnycklar säkert på den här enheten"
          }
        }
      }
    },
    "account.benefit.orders" : {
      "comment" : "First account benefit in the list on the Konto tab (signed-out state), next to a document icon: orders and invoices can be viewed at any time. One or two lines, max ~50 characters. Glossary: Bestellung (EN order), Rechnung (EN invoice).",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dine ordrer og fakturaer når som helst"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestellungen und Rechnungen jederzeit abrufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View orders and invoices at any time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultar pedidos y facturas en cualquier momento"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso tilauksesi ja laskusi milloin tahansa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulter vos commandes et factures à tout moment"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultare ordini e fatture in qualsiasi momento"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestellingen en facturen altijd inzien"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamówienia i faktury dostępne w każdej chwili"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultar encomendas e faturas a qualquer momento"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dina beställningar och fakturor när som helst"
          }
        }
