    "account.loyalty.wallet.error.message" : {
      "comment" : "Message of the alert when the Apple Wallet customer card could not be loaded. Formal address.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kundekortet til Apple Wallet kunne ikke indlæses lige nu. Prøv igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kundenkarte für Apple Wallet konnte gerade nicht geladen werden. Bitte versuchen Sie es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The customer card for Apple Wallet could not be loaded right now. Please try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido cargar ahora la tarjeta de cliente para Apple Wallet. Vuelva a intentarlo más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Walletin asiakaskorttia ei voitu ladata juuri nyt. Yritä myöhemmin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte client pour Apple Wallet n’a pas pu être chargée pour le moment. Veuillez réessayer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile caricare ora la carta cliente per Apple Wallet. Riprovi più tardi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De klantenkaart voor Apple Wallet kon nu niet worden geladen. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się teraz wczytać karty klienta do Apple Wallet. Spróbuj ponownie później."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar agora o cartão de cliente para a Apple Wallet. Tente novamente mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kundkortet för Apple Wallet kunde inte laddas just nu. Försök igen senare."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cardul de client pentru Apple Wallet nu a putut fi încărcat acum. Vă rugăm să încercați din nou mai târziu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάρτα πελάτη για το Apple Wallet δεν μπόρεσε να φορτωθεί αυτή τη στιγμή. Δοκιμάστε ξανά αργότερα."
          }
        }
      }
    },
