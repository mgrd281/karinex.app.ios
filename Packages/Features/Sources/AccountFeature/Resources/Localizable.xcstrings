            "state" : "translated",
            "value" : "Pedir a remoção da sua conta de cliente e dos dados guardados"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt ta bort ditt kundkonto och dina sparade uppgifter"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få din kundekonto og dine gemte data fjernet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita que se eliminen tu cuenta de cliente y tus datos guardados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire supprimer votre compte client et vos données enregistrées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
