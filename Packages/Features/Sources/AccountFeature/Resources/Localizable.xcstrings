    "account.loyalty.collect.hold.detail" : {
      "comment" : "Explanation under the hold row.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis dahin sind die Punkte ausstehend. Bei Rückgabe oder Erstattung werden sie entsprechend abgezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Until then the points are pending. On a return or refund they are deducted accordingly."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tego czasu punkty są oczekujące. W razie zwrotu lub zwrotu środków zostaną odpowiednio odjęte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot dan zijn de punten in afwachting. Bij een retour of terugbetaling worden ze dienovereenkomstig afgeschreven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até lá, os pontos ficam pendentes. Em caso de devolução ou reembolso, são descontados em conformidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fram till dess väntar poängen. Vid retur eller återbetalning dras de av i motsvarande mån."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtil da afventer pointene. Ved returnering eller refusion trækkes de tilsvarende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta entonces los puntos están pendientes. En caso de devolución o reembolso se descuentan en consecuencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'ici là, les points sont en attente. En cas de retour ou de remboursement, ils sont déduits en conséquence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a quel momento i punti sono in sospeso. In caso di reso o rimborso vengono detratti di conseguenza."
          }
        },
