    "account.loyalty.wallet.note" : {
      "comment" : "Hint under the official \"Add to Apple Wallet\" button on the loyalty screen: what the card is. Formal address.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit KARINEX-kundekort med niveau og point. Det opdateres af sig selv i Wallet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre KARINEX-Kundenkarte mit Stufe und Punkten. Sie aktualisiert sich im Wallet von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your KARINEX customer card with your level and points. It updates itself in Wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su tarjeta de cliente KARINEX con nivel y puntos. Se actualiza sola en Wallet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KARINEX-asiakaskorttisi tasolla ja pisteillä. Se päivittyy Walletissa itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre carte client KARINEX avec votre niveau et vos points. Elle se met à jour toute seule dans Wallet."
          }
        },
        "it" : {
