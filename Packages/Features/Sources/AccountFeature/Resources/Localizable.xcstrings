          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código pertenece a su cuenta y se puede usar una vez. Anótelo si desea usarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code est lié à votre compte et ne peut être utilisé qu'une fois. Notez-le si vous souhaitez l'utiliser plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
