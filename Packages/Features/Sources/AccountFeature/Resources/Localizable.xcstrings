        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres cerrar sesión? Las claves de licencia guardadas se eliminarán de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vous déconnecter ? Les clés de licence enregistrées seront supprimées de cet appareil."
