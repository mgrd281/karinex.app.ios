    "account.signout.confirm.title" : {
      "comment" : "Title of the sign-out confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie sich abmelden? Gespeicherte Lizenzschlüssel werden von diesem Gerät entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you want to sign out? Saved licence keys will be removed from this device."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz się wylogować? Zapisane klucze licencyjne zostaną usunięte z tego urządzenia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je je afmelden? Opgeslagen licentiesleutels worden van dit apparaat verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretende terminar sessão? As chaves de licença guardadas serão removidas deste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du logga ut? Sparade licensnycklar tas bort från den här enheten."
