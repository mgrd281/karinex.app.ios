        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di mostrarli, l’app chiede Face ID, Touch ID o il codice del dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen näyttämistä sovellus pyytää Face ID:tä, Touch ID:tä tai laitteen pääsykoodia."
