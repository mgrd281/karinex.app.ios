    "settings.notifications.deals.detail" : {
      "comment" : "Explanation below the deal notifications toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelegentlich eine Mitteilung, wenn ein neues Angebot beginnt. Sie können das jederzeit wieder ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An occasional notification when a new offer starts. You can turn this off at any time."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okazjonalne powiadomienie o rozpoczęciu nowej oferty. Możesz to wyłączyć w każdej chwili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af en toe een melding als er een nieuwe aanbieding start. Je kunt dit altijd weer uitzetten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação ocasional quando começa uma nova promoção. Pode desativar a qualquer momento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibland en avisering när ett nytt erbjudande börjar. Du kan stänga av det när som helst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gang imellem en notifikation, når et nyt tilbud starter. Du kan altid slå det fra igen."
