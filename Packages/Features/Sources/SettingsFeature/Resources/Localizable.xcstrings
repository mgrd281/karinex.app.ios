    "settings.licenses.lock.detail" : {
      "comment" : "Explanation below the lock toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Anzeigen fragt die App nach Face ID, Touch ID oder Ihrem Gerätecode."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before showing them, the app asks for Face ID, Touch ID or your device passcode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed wyświetleniem aplikacja poprosi o Face ID, Touch ID lub kod urządzenia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voordat ze worden getoond, vraagt de app om Face ID, Touch ID of de toegangscode van je apparaat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de as mostrar, a app pede Face ID, Touch ID ou o código do dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan de visas ber appen om Face ID, Touch ID eller enhetens lösenkod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før de vises, beder appen om Face ID, Touch ID eller enhedens adgangskode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de mostrarlas, la app pide Face ID, Touch ID o el código del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de les afficher, l’app demande Face ID, Touch ID ou le code de votre appareil."
