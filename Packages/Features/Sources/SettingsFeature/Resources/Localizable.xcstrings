    "settings.privacy.analytics.detail" : {
      "comment" : "Explanation below the analytics toggle.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft uns, die App zu verbessern. Ohne Ihre Zustimmung werden keine Nutzungsdaten erfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps us improve the app. No usage data is collected without your consent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaga nam ulepszać aplikację. Bez Twojej zgody nie zbieramy danych o korzystaniu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helpt ons de app te verbeteren. Zonder je toestemming worden geen gebruiksgegevens verzameld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda-nos a melhorar a app. Sem o seu consentimento, não são recolhidos dados de utilização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjälper oss att förbättra appen. Utan ditt samtycke samlas inga användningsdata in."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælper os med at forbedre appen. Uden dit samtykke indsamles der ingen brugsdata."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos ayuda a mejorar la app. Sin tu consentimiento no se recopilan datos de uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous aide à améliorer l’app. Sans votre consentement, aucune donnée d’utilisation n’est collectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci aiuta a migliorare l’app. Senza il tuo consenso non vengono raccolti dati di utilizzo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auttaa meitä parantamaan sovellusta. Ilman suostumustasi käyttötietoja ei kerätä."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne ajută să îmbunătățim aplicația. Fără acordul dumneavoastră, nu se colectează date de utilizare."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
