    "settings.language.message" : {
      "comment" : "Explains that the app language is set in the iOS per-app settings, the content language above.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprache der App stellen Sie in den iOS-Einstellungen ein. Die Sprache der Produkttexte wählen Sie oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You set the app language in the iOS settings. You choose the language of the product texts above."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język aplikacji ustawisz w ustawieniach iOS. Język opisów produktów wybierzesz powyżej."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De taal van de app stel je in via de iOS-instellingen. De taal van de productteksten kies je hierboven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O idioma da app é definido nas definições do iOS. O idioma dos textos dos produtos é escolhido acima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens språk ställer du in i iOS-inställningarna. Språket för produkttexterna väljer du ovan."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens sprog indstiller du i iOS-indstillingerne. Sproget for produktteksterne vælger du ovenfor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de la app se configura en los ajustes de iOS. El idioma de los textos de los productos lo eliges arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue de l’app se règle dans les réglages iOS. La langue des textes produits se choisit ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lingua dell’app si imposta nelle impostazioni di iOS. La lingua dei testi dei prodotti si sceglie qui sopra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen kieli valitaan iOS-asetuksista. Tuotetekstien kieli valitaan yllä."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limba aplicației o setați din setările iOS. Limba textelor produselor o alegeți mai sus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τη γλώσσα της εφαρμογής την ορίζετε στις ρυθμίσεις iOS. Τη γλώσσα των κειμένων των προϊόντων την επιλέγετε παραπάνω."
          }
        }
      }
    },
