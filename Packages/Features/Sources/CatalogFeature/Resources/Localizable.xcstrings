{
  "sourceLanguage" : "de",
  "strings" : {
    "catalog.empty.message" : {
      "comment" : "Text below the placeholder title on the Shop tab while the product catalogue is not yet available in the app: all categories and products of the store will be listed here, with current prices. No dates and no promises. KARINEX is the brand name: always uppercase, never translated. Max ~110 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her finder du fremover alle kategorier og produkter fra KARINEX-shoppen med aktuelle priser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier finden Sie künftig alle Kategorien und Produkte aus dem KARINEX-Shop mit aktuellen Preisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is where you will find every category and product from the KARINEX shop, with current prices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí encontrarás todas las categorías y productos de la tienda KARINEX, con sus precios actuales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täältä löydät jatkossa kaikki KARINEX-kaupan kategoriat ja tuotteet ajantasaisine hintoineen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous trouverez ici toutes les catégories et tous les produits de la boutique KARINEX, avec leurs prix actuels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui troverai tutte le categorie e tutti i prodotti del negozio KARINEX, con i prezzi aggiornati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier komen alle categorieën en producten van de KARINEX-shop te staan, met actuele prijzen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym miejscu pojawią się wszystkie kategorie i produkty ze sklepu KARINEX wraz z aktualnymi cenami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui encontrará todas as categorias e produtos da loja KARINEX, com preços atualizados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Här hittar du framöver alla kategorier och produkter i KARINEX-butiken, med aktuella priser."
          }
        }
      }
    },
    "catalog.empty.title" : {
      "comment" : "Serif title of the placeholder on the Shop tab until the product catalogue is available in the app. Short, max ~40 characters. Glossary: Sortiment (EN range).",
