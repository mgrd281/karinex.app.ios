{
  "sourceLanguage" : "de",
  "strings" : {
    "catalog.collection.empty.message" : {
      "comment" : "Message shown when a collection has no products.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Kollektion sind im Moment keine Produkte verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are no products in this collection right now."
          }
        }
      }
    },
    "catalog.collection.empty.title" : {
      "comment" : "Title shown when a collection has no products.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Produkte"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No products"
          }
        }
      }
    },
    "catalog.collection.eyebrow.filtered %@ %lld" : {
      "comment" : "Small uppercase label above a collection title: %1$@ is the chosen sort order (e.g. Empfohlen), %2$lld the number of active filters. Keep it short.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Filter: %2$lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Filters: %2$lld"
          }
        }
      }
    },
    "catalog.collection.filtered_empty.message" : {
      "comment" : "Message shown when no product of a collection matches the chosen filters.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die gewählten Filter wurden keine Produkte gefunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No products match the selected filters."
          }
        }
      }
    },
    "catalog.collection.filtered_empty.title" : {
      "comment" : "Title shown when no product of a collection matches the chosen filters.",
