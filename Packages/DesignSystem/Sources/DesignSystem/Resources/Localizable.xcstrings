    "kx.price.accessibility.compare %@ %@" : {
      "comment" : "VoiceOver only, never shown on screen, so there is no length limit. Spoken price on price tags and product cards when a former price is shown struck through. %1$@ is the current price and %2$@ the former (compare-at) price, both already formatted with currency by the app, for example \"Preis 12,90 €, statt 79,99 €\". Do not add currency symbols. Reorder the placeholders if needed, keeping their numbers.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pris %1$@, før %2$@"
