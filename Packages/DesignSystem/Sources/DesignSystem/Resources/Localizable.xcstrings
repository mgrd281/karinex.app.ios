    "kx.banner.error.message" : {
      "comment" : "Default message of the error banner at the top of the screen when an action or a loading request failed and the screen has no more specific text. Often followed by the \"kx.banner.retry\" button on the same line. Calm, no blame, no technical terms. Two short sentences, max ~80 characters.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlingen kunne ikke gennemføres. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Vorgang konnte nicht abgeschlossen werden. Bitte versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This could not be completed. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido completar la operación. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toimintoa ei voitu suorittaa loppuun. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération n’a pas pu aboutir. Veuillez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile completare l’operazione. Riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is niet gelukt. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zakończyć operacji. Prosimy spróbować ponownie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir a operação. Tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att slutföra åtgärden. Försök igen."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operațiunea nu a putut fi finalizată. Vă rugăm să încercați din nou."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενέργεια δεν ολοκληρώθηκε. Παρακαλούμε δοκιμάστε ξανά."
          }
        }
      }
    },
