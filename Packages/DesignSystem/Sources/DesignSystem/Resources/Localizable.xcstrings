          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet offline-tilassa. Tarkista internetyhteytesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Vérifiez votre connexion Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. Controlla la connessione a Internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline. Controleer je internetverbinding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia z internetem. Prosimy sprawdzić ustawienia sieci."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está offline. Verifique a ligação à Internet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är offline. Kontrollera din internetanslutning."
          }
        }
      }
    },
