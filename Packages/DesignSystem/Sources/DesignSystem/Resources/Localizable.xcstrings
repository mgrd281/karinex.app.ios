    "kx.banner.offline.message" : {
      "comment" : "Message of the banner at the top of every screen while the device has no internet connection; VoiceOver announces it when it appears. Two short sentences, max ~65 characters, so the banner stays compact.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er offline. Tjek din internetforbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind offline. Bitte prüfen Sie Ihre Internetverbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are offline. Please check your internet connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. Comprueba tu acceso a Internet."
