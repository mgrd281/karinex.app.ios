{
  "sourceLanguage" : "de",
  "strings" : {
    "kx.accordion.collapsed" : {
      "comment" : "VoiceOver value of a collapsed accordion row (for example an FAQ question whose answer is hidden). Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingeklappt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collapsed"
          }
        }
      }
    },
    "kx.accordion.expanded" : {
      "comment" : "VoiceOver value of an expanded accordion row (for example an FAQ question whose answer is visible). Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeklappt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expanded"
          }
        }
      }
    },
    "kx.accordion.hint.collapse" : {
      "comment" : "VoiceOver hint of an expanded accordion row: what double-tapping does. Short sentence describing the result. Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet den Inhalt aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides the content."
          }
        }
      }
    },
    "kx.accordion.hint.expand" : {
      "comment" : "VoiceOver hint of a collapsed accordion row: what double-tapping does. Short sentence describing the result. Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet den Inhalt ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the content."
          }
        }
      }
    },
    "kx.banner.dismiss" : {
      "comment" : "VoiceOver label of the close (x) button of a status banner. Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis schließen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close notice"
          }
        }
      }
    },
    "kx.banner.error.message" : {
      "comment" : "Default message of a status banner after a request failed, when the screen provides no more specific text. One or two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An error occurred. Please try again."
          }
        }
      }
    },
    "kx.banner.info.message" : {
      "comment" : "Fallback message of a neutral information banner when the screen provides no text. One or two words.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notice"
          }
        }
      }
    },
    "kx.banner.offline.message" : {
      "comment" : "Default message of the banner shown at the top of the screen while the device has no internet connection. One or two short sentences.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Internetverbindung. Bitte prüfen Sie Ihre Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No internet connection. Please check your connection."
          }
        }
      }
    },
    "kx.banner.retry" : {
      "comment" : "Default label of the text button in a status banner (offline or error) that repeats the failed action. Short: it sits next to the banner message.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut versuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        }
      }
    },
    "kx.banner.success.message" : {
      "comment" : "Fallback message of a success banner when the screen provides no text, e.g. after an action completed. Short sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolgreich abgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completed successfully."
          }
        }
      }
    },
    "kx.button.loading" : {
      "comment" : "VoiceOver value of a design-system button while its action is in progress (a spinner replaces the label). Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird geladen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loading"
          }
        }
      }
    },
    "kx.countdown.accessibility.days %lld" : {
      "comment" : "VoiceOver fragment for the days of a deal countdown. Inserted into 'kx.countdown.accessibility.remaining %@' and joined with the hours and minutes fragments by commas, e.g. 'Endet in 2 Tagen, 3 Stunden, 4 Minuten'. German uses the dative after 'in'. Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Tag"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Tagen"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld day"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld days"
                }
              }
            }
          }
        }
      }
    },
    "kx.countdown.accessibility.ended" : {
