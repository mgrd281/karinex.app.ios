    "kx.timeline.step %lld %lld %@" : {
      "comment" : "VoiceOver label of one step in a numbered step timeline such as 'So läuft es ab'. %1$lld is the step number, %2$lld the number of steps, %3$@ the step title, e.g. 'Schritt 2 von 3: Bezahlen'. Not shown visually.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritt %1$lld von %2$lld: %3$@"
          }
