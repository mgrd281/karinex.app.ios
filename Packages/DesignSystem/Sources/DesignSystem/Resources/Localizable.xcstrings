    "kx.countdown.accessibility.days %lld" : {
      "comment" : "VoiceOver only, never shown on screen, so there is no length limit. Days part of a deal countdown; %lld is the number of days. Inserted into \"kx.countdown.accessibility.remaining %@\" and joined with the hours and minutes parts in the list format of your language (commas and a final \"and\"), for example \"Endet in 2 Tagen, 3 Stunden und 4 Minuten\". Use the grammatical form that fits inside that sentence in your language (German needs the dative \"Tagen\" after \"in\"; languages with cases use the matching case). Provide every plural form of your language.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
