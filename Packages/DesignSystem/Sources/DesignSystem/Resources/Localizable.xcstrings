    "kx.keycard.copy.hint" : {
      "comment" : "VoiceOver only, never shown on screen, so there is no length limit. Hint of the copy button on the licence card: the key is copied and deleted from the clipboard automatically after two minutes (the app sets this expiry). Keep \"two minutes\" exact.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierer licensnøglen til udklipsholderen. Efter to minutter slettes den automatisk derfra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert den Lizenzschlüssel in die Zwischenablage. Nach zwei Minuten wird er dort automatisch gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies the licence key to the clipboard. It is cleared automatically after two minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la clave de licencia en el portapapeles. Se eliminará automáticamente al cabo de dos minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopioi lisenssiavaimen leikepöydälle. Kahden minuutin kuluttua se poistetaan sieltä automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie la clé de licence dans le presse-papiers. Elle y est automatiquement effacée au bout de deux minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia il codice di licenza negli appunti. Dopo due minuti viene eliminato automaticamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieert de licentiesleutel naar het klembord. Na twee minuten wordt hij daar automatisch verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiuje klucz licencyjny do schowka. Po dwóch minutach zostanie z niego automatycznie usunięty."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia a chave de licença para a área de transferência. Após dois minutos, é apagada automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierar licensnyckeln till urklipp. Efter två minuter raderas den automatiskt därifrån."
          }
        }
      }
    },
