          "stringUnit" : {
            "state" : "translated",
            "value" : "So that you can unlock your licence keys with Face ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby odblokowywać klucze licencyjne za pomocą Face ID."
