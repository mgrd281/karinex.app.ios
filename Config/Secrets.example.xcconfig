// Copy to Config/Secrets.xcconfig (git-ignored) and fill in. Never commit real values.
// CI writes this file from repository secrets.

// Public Storefront API token of the KARINEX Headless channel. Scopes:
// unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
// unauthenticated_read_product_tags, unauthenticated_read_collection_listings,
// unauthenticated_read_content, unauthenticated_read_metaobjects,
// unauthenticated_read_metafields (via definitions with Storefront access),
// unauthenticated_write_checkouts / unauthenticated_read_checkouts (cart).
KX_STOREFRONT_ACCESS_TOKEN =

// Customer Account API public client ID (Headless channel > Customer Account API).
KX_CUSTOMER_ACCOUNT_CLIENT_ID =

// Apple Developer team ID (10 characters) used for signing.
KX_APPLE_TEAM_ID =

// Entitlements file with the Associated Domains entitlement for Universal Links
// (applinks:www.karinex.de, applinks:karinex.de). Set it to App/KARINEX.entitlements once
// KX_APPLE_TEAM_ID is set and the team's App ID has Associated Domains enabled; leave it empty
// for builds without a team (simulator, CI), which then sign without entitlements.
KX_CODE_SIGN_ENTITLEMENTS =
